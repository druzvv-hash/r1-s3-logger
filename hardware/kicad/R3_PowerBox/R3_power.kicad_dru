(version 1)
(rule "M3 hardware envelope - explicit copper check"
  (condition "A.intersectsArea('M3_H1') || A.intersectsArea('M3_H2') || A.intersectsArea('M3_H3') || A.intersectsArea('M3_H4') || A.intersectsArea('M3_H5') || A.intersectsArea('M3_H6')")
  (constraint disallow track via zone))
(rule "R3 all-layer isolation - no conductive objects"
  (condition "A.intersectsArea('ISOLATION_CORRIDOR')")
  (constraint disallow track via pad zone))

# General project clearance is 0.13 mm. This is deliberately above the
# selected 4-layer manufacturer's 0.09 mm standard capability while accepting
# the 0.13-0.15 mm intrinsic spacing of the verified QFN/VSON land patterns.
# Routing should still use 0.20 mm wherever density does not require less.
(rule "R3 project copper clearance"
  (constraint clearance (min 0.13mm)))

# Standard fabrication geometry selected for all routing-added vias.
(rule "Standard plated drill"
  (condition "A.isPlated() && A.Type == 'Via'")
  (constraint hole_size (min 0.30mm)))

(rule "Standard via annular ring"
  (condition "A.Type == 'Via'")
  (constraint annular_width (min 0.20mm)))
